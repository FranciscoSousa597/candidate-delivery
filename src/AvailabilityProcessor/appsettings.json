{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dependencies": {
    "ProductContextBaseUrl": "http://127.0.0.1:8080",
    "AvailabilityApiBaseUrl": "http://127.0.0.1:8080",
    "EventSinkBaseUrl": "http://127.0.0.1:8080"
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "BaseRetryDelay": "00:00:00.200",
    "MaxRetryDelay": "00:00:05",
    "AttemptTimeout": "00:00:10",
    "TotalTimeout": "00:01:00",
    "MaxConcurrentRequests": 16,
    "MaxQueuedRequests": 1000,
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 20,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:05"
    }
  },
  "BulkImport": {
    "MaxDegreeOfParallelism": 8,
    "MaxQueuedJobs": 10,
    "MaxReportedRowResults": 1000
  },
  "Outbox": {
    "RelayInterval": "00:00:10"
  },
  "Storage": {
    "ConnectionString": "Data Source=availability.db"
  }
}
